# =====================================================================
# Web3 Intelligence Radar - Environment Template
# Copy to .env and fill in. NEVER commit real values.
# Only configure the providers you actually use (see config/models.yaml).
# =====================================================================

# ---------- LLM Providers (configure only the ones you use) ----------
# Default roles use openai, so OPENAI_API_KEY is required unless you change
# config/models.yaml roles.* to a different provider.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
TENCENT_LLM_API_KEY=
VOLCENGINE_API_KEY=
OPENCODE_GO_API_KEY=
GEMINI_API_KEY=
CUSTOM_LLM_API_KEY=
# Optional: override OpenAI base URL (e.g. Azure / proxy) — only for openai provider
OPENAI_BASE_URL=

# ---------- Lark Industry (REQUIRED for Industry push) ----------
LARK_WEBHOOK_INDUSTRY=
# Optional: Lark custom bot signing secret (HMAC-SHA256)
LARK_SIGNING_SECRET_INDUSTRY=

# ---------- Lark Competitor (REQUIRED for Competitor push) ----------
LARK_WEBHOOK_COMPETITOR=
# Optional: Lark custom bot signing secret
LARK_SIGNING_SECRET_COMPETITOR=

# ---------- Optional Local Delivery (Local HTTP receiver) ----------
LOCAL_WEBHOOK_URL=
LOCAL_WEBHOOK_TOKEN=

# ---------- Cost Guard (system) ----------
# Monthly LLM budget in USD (default 5, provider-agnostic)
MONTHLY_AI_BUDGET_USD=5
# Max LLM calls per single run (default 20)
MAX_AI_CALLS_PER_RUN=20

# ---------- GitHub Actions only (set automatically) ----------
# GITHUB_TOKEN is provided by GitHub Actions; do not set manually.
